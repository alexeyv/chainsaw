# Sample chainsaw.toml: copy into the run directory as chainsaw.toml.
# Every key is optional and the values here are the defaults.
# `--set KEY=VALUE` before the subcommand overrides a key for one process.

# Seconds a sent prompt gets to reach the transcript before it is resent.
prompt-timeout-seconds = 15

# Each role's agent is the coding agent it runs; claude is the only one today.
# Each role's args are split like a shell would and passed to the agent as written:
# quote a value that contains spaces, e.g. --append-system-prompt 'be terse'.

[implementer]
agent = "claude"
args = "--model opus --effort high --disable-slash-commands --strict-mcp-config --no-chrome --disallowedTools WebSearch,WebFetch,NotebookEdit,Task,Agent,AskUserQuestion,EnterPlanMode,ExitPlanMode,TaskOutput"

[commentator]
agent = "claude"
args = "--model opus --effort high --strict-mcp-config --no-chrome --disallowedTools WebSearch,WebFetch,NotebookEdit,Task,Agent,AskUserQuestion,EnterPlanMode,ExitPlanMode,TaskOutput"
