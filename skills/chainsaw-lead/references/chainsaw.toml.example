# Sample chainsaw.toml. Every key is optional and the values here are the
# defaults. Settings come from up to three files, each laid over the previous
# one key by key, so write only the keys you want to change:
#   ~/.config/chainsaw/chainsaw.toml   your defaults for every project
#                                      ($XDG_CONFIG_HOME/chainsaw/chainsaw.toml when set)
#   chainsaw.toml                      in the run directory, checked in
#   chainsaw.local.toml                in the run directory, gitignored
# `--set KEY=VALUE` before the subcommand overrides a key for one process.
# A key overrides as a whole: a file that sets a role's args replaces the
# entire flag list of the layer below, not just the flags it mentions.

# Seconds a sent prompt gets to reach the transcript before it is resent.
prompt-timeout-seconds = 15

# Each role's agent is the coding agent it runs: claude (the default) or codex.
# Codex's default args are "--dangerously-bypass-approvals-and-sandbox ."; the
# trailing dot is its first prompt, which is what gives it a session id.
# Each role's args are split like a shell would and passed to the agent as written:
# quote a value that contains spaces, e.g. --append-system-prompt 'be terse'.

[implementer]
agent = "claude"
args = "--model opus --effort high --disable-slash-commands --strict-mcp-config --no-chrome --disallowedTools WebSearch,WebFetch,NotebookEdit,Task,Agent,AskUserQuestion,EnterPlanMode,ExitPlanMode,TaskOutput"

[commentator]
agent = "claude"
args = "--model opus --effort high --strict-mcp-config --no-chrome --disallowedTools WebSearch,WebFetch,NotebookEdit,Task,Agent,AskUserQuestion,EnterPlanMode,ExitPlanMode,TaskOutput"
