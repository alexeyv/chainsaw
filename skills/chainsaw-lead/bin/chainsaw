#!/usr/bin/env bash
set -euo pipefail

CRATE=$(cd "$(dirname "$0")/../coordinator" && pwd)
BIN="$CRATE/target/debug/chainsaw"

if [ ! -e "$BIN" ] || [ -n "$(find "$CRATE/src" "$CRATE/Cargo.toml" "$CRATE/Cargo.lock" -newer "$BIN")" ]; then
  cargo build --quiet --manifest-path "$CRATE/Cargo.toml" 1>&2
fi

exec "$BIN" "$@"
