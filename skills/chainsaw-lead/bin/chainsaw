#!/usr/bin/env bash
set -euo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
SKILL=$(cd "$HERE/.." && pwd)
REPO_CANDIDATE=$(cd "$SKILL/../.." && pwd)

if [ -f "$REPO_CANDIDATE/Cargo.toml" ] && [ -f "$REPO_CANDIDATE/skills/chainsaw-lead/SKILL.md" ]; then
  CRATE="$REPO_CANDIDATE"
elif [ -f "$SKILL/supervisor/Cargo.toml" ]; then
  CRATE="$SKILL/supervisor"
else
  echo "chainsaw: cannot find supervisor crate" >&2
  exit 1
fi

BIN="$CRATE/target/debug/chainsaw"

if [ ! -e "$BIN" ] || [ -n "$(find "$CRATE/src" "$CRATE/Cargo.toml" "$CRATE/Cargo.lock" -newer "$BIN")" ]; then
  cargo build --quiet --manifest-path "$CRATE/Cargo.toml" 1>&2
fi

exec "$BIN" "$@"
